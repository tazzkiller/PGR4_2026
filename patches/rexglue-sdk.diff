+namespace {
+
+constexpr uint16_t kPeerPort = 3075;
+constexpr char kHeartbeat[4] = {'R', 'X', 'H', 'B'};
+constexpr char kGoodbye[4] = {'R', 'X', 'B', 'Y'};
+using PeerClock = std::chrono::steady_clock;
+// A heartbeat each 500 ms to the PCs the game sent to in the last 30 s; lost after 6 s without
+// one, while the game sent to it in the last 3 s (a game no longer talking to a PC loses none).
+constexpr auto kBeatInterval = std::chrono::milliseconds(500);
+constexpr auto kBeatFor = std::chrono::seconds(30);
+constexpr auto kSilence = std::chrono::seconds(6);
+constexpr auto kTalking = std::chrono::seconds(3);
+
+struct SystemLinkPeer {
+  PeerClock::time_point sent;   // the game's last packet to it
+  PeerClock::time_point heard;  // its last packet or heartbeat
+  bool beats = false;           // it sends heartbeats (silence counts)
+  bool goodbye = false;
+};
+
+std::mutex peers_mutex;
+std::unordered_map<uint32_t, SystemLinkPeer> peers;
+#if REX_PLATFORM_WIN32
+SOCKET peer_socket = INVALID_SOCKET;
+#endif
+
+// A unicast address of another PC: not broadcast (limited or a local network's), multicast or
+// loopback.
+bool IsPeerAddress(uint32_t ip) {
+  if (!ip || ip == 0xFFFFFFFFu || (ip >> 24) == 127 || (ip >> 28) == 0xE) {
+    return false;
+  }
+  for (const LanInterface& lan : GetLanInterfaces()) {
+    if (ip == ntohl(lan.ip) || ip == ntohl(lan.ip | ~lan.mask)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool PeerLost(const SystemLinkPeer& peer, PeerClock::time_point now) {
+  return now - peer.sent < kTalking &&
+         (peer.goodbye || (peer.beats && now - peer.heard > kSilence));
+}
+
+#if REX_PLATFORM_WIN32
+void SendPeerPacket(uint32_t ip, const char (&packet)[4]) {
+  sockaddr_in to = {};
+  to.sin_family = AF_INET;
+  to.sin_port = htons(kPeerPort);
+  to.sin_addr.s_addr = htonl(ip);
+  sendto(peer_socket, packet, sizeof(packet), 0, reinterpret_cast<sockaddr*>(&to), sizeof(to));
+}
+
+void PeerThread() {
+  auto next_beat = PeerClock::now();
+  for (;;) {
+    fd_set set;
+    FD_ZERO(&set);
+    FD_SET(peer_socket, &set);
+    timeval timeout = {0, 100000};
+    if (select(0, &set, nullptr, nullptr, &timeout) > 0) {
+      char packet[16];
+      sockaddr_in from = {};
+      int from_len = sizeof(from);
+      const int n = recvfrom(peer_socket, packet, sizeof(packet), 0,
+                             reinterpret_cast<sockaddr*>(&from), &from_len);
+      if (n == 4) {
+        std::lock_guard<std::mutex> lock(peers_mutex);
+        auto it = peers.find(ntohl(from.sin_addr.s_addr));
+        if (it != peers.end()) {
+          if (std::memcmp(packet, kHeartbeat, 4) == 0) {
+            it->second.heard = PeerClock::now();
+            it->second.beats = true;
+          } else if (std::memcmp(packet, kGoodbye, 4) == 0) {
+            if (!it->second.goodbye) {
+              REXLOG_INFO("System link: {:08X} said goodbye", it->first);
+            }
+            it->second.goodbye = true;
+          }
+        }
+      }
+    }
+    const auto now = PeerClock::now();
+    if (now < next_beat) {
+      continue;
+    }
+    next_beat = now + kBeatInterval;
+    std::vector<uint32_t> beat_to;
+    {
+      std::lock_guard<std::mutex> lock(peers_mutex);
+      for (const auto& [ip, peer] : peers) {
+        if (now - peer.sent < kBeatFor) {
+          beat_to.push_back(ip);
+        }
+      }
+    }
+    for (const uint32_t ip : beat_to) {
+      SendPeerPacket(ip, kHeartbeat);
+    }
+  }
+}
+#endif
+
+// The heartbeat socket and thread, at the game's first system link traffic (Winsock started).
+void StartPeerThread() {
+#if REX_PLATFORM_WIN32
+  static std::once_flag once;
+  std::call_once(once, [] {
+    SOCKET s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == INVALID_SOCKET) {
+      return;
+    }
+    sockaddr_in addr = {};
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(kPeerPort);
+    if (bind(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+      // Another instance on this PC has it: no heartbeats, peers lost on goodbyes only.
+      REXLOG_WARN("System link: heartbeat port {} in use", kPeerPort);
+      closesocket(s);
+      return;
+    }
+    // No WSAECONNRESET from a closed peer's ICMP "port unreachable".
+    DWORD no_reset = FALSE, bytes = 0;
+    WSAIoctl(s, _WSAIOW(IOC_VENDOR, 12), &no_reset, sizeof(no_reset), nullptr, 0, &bytes,
+             nullptr, nullptr);
+    peer_socket = s;
+    std::thread(PeerThread).detach();
+  });
+#endif
+}
+
+}  // namespace
+
+void NoteSystemLinkSend(uint32_t ip) {
+  if (!IsPeerAddress(ip)) {
+    return;
+  }
+  StartPeerThread();
+  const auto now = PeerClock::now();
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  auto [it, added] = peers.try_emplace(ip);
+  if (added) {
+    it->second.heard = now;
+  }
+  it->second.sent = now;
+}
+
+void NoteSystemLinkReceive(uint32_t ip) {
+  if (!IsPeerAddress(ip)) {
+    return;
+  }
+  StartPeerThread();
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  SystemLinkPeer& peer = peers[ip];
+  peer.heard = PeerClock::now();
+  peer.goodbye = false;
+}
+
+void ForgetSystemLinkPeer(uint32_t ip) {
+  {
+    std::lock_guard<std::mutex> lock(peers_mutex);
+    if (!peers.erase(ip)) {
+      return;
+    }
+  }
+#if REX_PLATFORM_WIN32
+  if (peer_socket != INVALID_SOCKET) {
+    for (int i = 0; i < 3; ++i) {
+      SendPeerPacket(ip, kGoodbye);
+    }
+  }
+#endif
+}
+
+bool SystemLinkPeerLost(uint32_t ip) {
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  auto it = peers.find(ip);
+  return it != peers.end() && PeerLost(it->second, PeerClock::now());
+}
+
+bool SystemLinkPeersLost() {
+  const auto now = PeerClock::now();
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  // Lost peers, and none of the game's others (sent to in the last 30 s) still beating: a guest
+  // gone leaves the other guests with the host.
+  bool lost = false;
+  for (const auto& [ip, peer] : peers) {
+    if (PeerLost(peer, now)) {
+      lost = true;
+    } else if (now - peer.sent < kBeatFor && !peer.goodbye && now - peer.heard <= kSilence) {
+      return false;
+    }
+  }
+  return lost;
+}
