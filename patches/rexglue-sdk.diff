+// pgr4 project: other players' profiles (split screen).
+xam::UserProfile* KernelState::SignInUser(uint32_t index, const std::string& name) {
+  if (index == 0 || index >= 4) return nullptr;
+  if (!user_profiles_[index]) {
+    user_profiles_[index] = std::make_unique<xam::UserProfile>();
+    user_profiles_[index]->set_kernel_state(this);
+    // Profile 0's xuid with the index in its low byte (clear of the 3<<54 permission mask).
+    user_profiles_[index]->set_xuid((user_profiles_[0]->xuid() & ~0xFFull) | (0xC0 + index));
+  }
+  user_profiles_[index]->set_name(name);
+  // XN_SYS_SIGNINCHANGED
+  BroadcastNotification(0x0000000A, signed_in_mask());
+  return user_profiles_[index].get();
+}
+
+bool KernelState::SignOutUser(uint32_t index) {
+  if (index == 0 || index >= 4 || !user_profiles_[index]) return false;
+  signed_out_profiles_.push_back(std::move(user_profiles_[index]));
+  // XN_SYS_SIGNINCHANGED
+  BroadcastNotification(0x0000000A, signed_in_mask());
+  return true;
+}
+
+void KernelState::FinishSigninUI() {
+  // XN_SYS_SIGNINCHANGED
+  BroadcastNotification(0x0000000A, signed_in_mask());
+  // XN_SYS_UI (off)
+  BroadcastNotification(0x00000009, 0);
+}
+
+uint32_t KernelState::signed_in_mask() const {
+  uint32_t mask = 0;
+  for (uint32_t i = 0; i < 4; ++i)
+    if (user_profiles_[i]) mask |= 1u << i;
+  return mask;
+}
+
 }  // namespace rex::system
