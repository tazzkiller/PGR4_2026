+
+bool AudioMediaPlayer::IsLastSongInPlaylist() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return IsLastSongInPlaylistLocked();
+}
+
+bool AudioMediaPlayer::IsLastSongInPlaylistLocked() const {
+  if (!active_playlist_) {
+    return false;
+  }
+
+  const auto& songs = active_playlist_->songs;
+  auto itr = std::ranges::find_if(songs, [this](const std::unique_ptr<XmpApp::Song>& song) {
+    return song->handle == current_song_handle_;
+  });
+  return itr == songs.cend() || std::next(itr) == songs.cend();
+}
+
+void AudioMediaPlayer::SetCaptureCallback(uint32_t callback, uint32_t context, bool title_render) {
+  // Canary leaves the callback off ("something is incorrect with callback and causes audio to be
+  // muted"): the music goes straight out. Local change (pgr4 project, 14/11/2026): kept for the title,
+  // which xmp_capture_output hands the music (TakeCaptureBlock, from the audio worker, a guest thread).
+  callback_ = 0;
+  callback_context_ = context;
+  is_title_rendering_enabled_ = false;
+  capture_context_.store(context, std::memory_order_relaxed);
+  capture_title_render_.store(title_render, std::memory_order_relaxed);
+  capture_callback_.store(callback, std::memory_order_release);
+  REXAPU_INFO("AudioMediaPlayer: XMPCaptureOutput callback {:08X} context {:08X} title render {}{}",
+              callback, context, title_render, CaptureActive() ? " (the music goes to the title)" : "");
+}
+
+void AudioMediaPlayer::ReturnCaptureBlock() {
+  std::lock_guard<std::mutex> lock(capture_mutex_);
+  capture_fifo_.insert(capture_fifo_.begin(), capture_last_.begin(), capture_last_.end());
+  capture_last_.clear();
+  capture_returned_ = true;
+  capture_time_frames_ += capture_last_frames_;
+  --capture_handed_;
+}
+
+bool AudioMediaPlayer::CaptureActive() const {
+  return REXCVAR_GET(xmp_capture_output) && capture_callback_.load(std::memory_order_acquire) &&
+         capture_title_render_.load(std::memory_order_relaxed);
+}
+
+// A decoded frame (AudioDriver::kFrameSamplesMax floats, capture_channels_ interleaved, at capture_rate_)
+// resampled (linear) to 48 kHz stereo 16-bit for the title. Waits while the title has more than about
+// 170 ms to take; false when the song was stopped.
+bool AudioMediaPlayer::CaptureFrame(const Request& request, const float* samples) {
+  constexpr size_t kMaxQueued = 2 * 8192;
+  std::unique_lock<std::mutex> lock(capture_mutex_);
+  while (capture_fifo_.size() > kMaxQueued) {
+    if (!IsCurrent(request)) return false;
+    if (!CaptureActive()) break;
+    capture_cv_.wait_for(lock, std::chrono::milliseconds(20));
+  }
+  const uint32_t channels = std::max<uint32_t>(capture_channels_, 1);
+  const uint32_t frames = AudioDriver::kFrameSamplesMax / channels;
+  const double step = double(capture_rate_) / 48000.0;
+  for (uint32_t f = 0; f < frames; ++f) {
+    const float l = samples[f * channels], r = channels > 1 ? samples[f * channels + 1] : l;
+    while (capture_phase_ < 1.0) {
+      const float k = float(capture_phase_);
+      capture_fifo_.push_back(capture_previous_[0] + (l - capture_previous_[0]) * k);
+      capture_fifo_.push_back(capture_previous_[1] + (r - capture_previous_[1]) * k);
+      capture_phase_ += step;
+    }
+    capture_phase_ -= 1.0;
+    capture_previous_[0] = l;
+    capture_previous_[1] = r;
+  }
+  return true;
+}
+
+bool AudioMediaPlayer::TakeCaptureBlock(uint32_t* callback, uint32_t* block, uint32_t* context) {
+  // The title's voice keeps a pointer to each block until it plays it, and takes many ahead: blocks
+  // reused while still queued (16 at first) skipped the music forward (fast, crackling).
+  constexpr uint32_t kBytes = 2048, kSlots = 512;
+  if (!CaptureActive()) return false;
+  // Paused, nothing: the music the title gets stops as the driver's output did (it stayed playing when
+  // the title paused or stopped the player). Stopped, what was queued goes too.
+  if (!IsPlaying()) {
+    capture_clock_ = {};
+    if (IsIdle()) {
+      std::lock_guard<std::mutex> lock(capture_mutex_);
+      capture_fifo_.clear();
+      capture_cv_.notify_all();
+    }
+    return false;
+  }
+  // 16-bit: 512 frames a block; float: 256.
+  const int32_t format = std::clamp(REXCVAR_GET(xmp_capture_format), 0, 3);
+  const uint32_t kFrames = format < 2 ? 512 : 256;
+  // Paced by the title's voice and by time: a block while the voice takes them (one it refuses comes
+  // back, ReturnCaptureBlock, with its time) and the time played allows, at most 100 ms ahead. The
+  // clock alone lost blocks the voice was not ready for (crackling) or left it short (slow); the voice
+  // alone took blocks far ahead.
+  const auto now = std::chrono::steady_clock::now();
+  if (capture_clock_.time_since_epoch().count() == 0) {
+    capture_clock_ = now;
+    capture_time_frames_ = 4800.0;
+  }
+  capture_time_frames_ = std::min(
+      capture_time_frames_ + std::chrono::duration<double>(now - capture_clock_).count() * 48000.0, 4800.0);
+  capture_clock_ = now;
+  if (capture_time_frames_ < kFrames) return false;
+  capture_time_frames_ -= kFrames;
+  capture_last_frames_ = kFrames;
+  std::lock_guard<std::mutex> lock(capture_mutex_);
+  if (capture_fifo_.size() < kFrames * 2) {  // nothing playing, or not decoded yet
+    ++capture_starved_;
+    capture_time_frames_ += kFrames;
+    return false;
+  }
+  if (++capture_handed_ % 5625 == 0)  // about a minute (16-bit)
+    REXAPU_INFO("AudioMediaPlayer: capture: {} blocks handed to the title, {} times nothing to hand",
+                capture_handed_, capture_starved_);
+  auto* memory = audio_system_ ? audio_system_->memory() : nullptr;
+  if (!memory) return false;
+  if (!capture_blocks_) {
+    capture_blocks_ = memory->SystemHeapAlloc(kBytes * kSlots);
+    if (!capture_blocks_) return false;
+  }
+  const uint32_t address = capture_blocks_ + (capture_next_++ % kSlots) * kBytes;
+  auto* out = memory->TranslateVirtual<uint8_t*>(address);
+  capture_last_.assign(capture_fifo_.begin(), capture_fifo_.begin() + kFrames * 2);
+  for (uint32_t i = 0; i < kFrames * 2; ++i) {
+    const float v = std::clamp(capture_fifo_.front(), -1.0f, 1.0f);
+    capture_fifo_.pop_front();
+    if (format < 2) {
+      const int16_t s = int16_t(std::lround(v * 32767.0f));
+      if (format == 0) memory::store_and_swap<int16_t>(out + 2 * i, s);
+      else std::memcpy(out + 2 * i, &s, 2);
+    } else if (format == 2) {
+      memory::store_and_swap<float>(out + 4 * i, v);
+    } else {
+      std::memcpy(out + 4 * i, &v, 4);
+    }
+  }
+  capture_cv_.notify_all();
+  *callback = capture_callback_.load(std::memory_order_relaxed);
+  *block = address;
+  *context = capture_context_.load(std::memory_order_relaxed);
+  return true;
+}
+
+void AudioMediaPlayer::OnStateChanged() {
+  kernel_state_->BroadcastNotification(kernel::xam::apps::kXNotificationXmpStateChanged,
+                                       static_cast<uint32_t>(GetState()));
+}
+
+bool AudioMediaPlayer::SetupDriver(uint32_t sample_rate, uint32_t channels) {
+  DeleteDriver();
+  {
+    // Local change (pgr4 project): the song's format for the capture (CaptureFrame), which starts
+    // over with it.
+    std::lock_guard<std::mutex> lock(capture_mutex_);
+    capture_rate_ = sample_rate;
+    capture_channels_ = channels;
+    capture_phase_ = 0.0;
+    capture_previous_[0] = capture_previous_[1] = 0.0f;
+    capture_fifo_.clear();
+  }
+
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (!sample_rate || !channels || channels > AudioDriver::kFrameSamplesMax) {
+    return false;
+  }
+  driver_semaphore_ = rex::thread::Semaphore::Create(kQueuedFrames, kQueuedFrames);
+
+  if (!driver_semaphore_) {
+    return false;
+  }
+
+  if (audio_system_) {
+    driver_.reset(
+        audio_system_->CreateDriver(driver_semaphore_.get(), sample_rate, channels, false));
+  }
+  if (driver_ && driver_->Initialize()) {
+    return true;
+  }
+  if (driver_) {
+    driver_->Shutdown();
+    driver_.reset();
+  }
+  driver_ = std::make_unique<PacingAudioDriver>(driver_semaphore_.get(), sample_rate,
+                                                AudioDriver::kFrameSamplesMax / channels);
+  if (!driver_->Initialize()) {
+    driver_.reset();
+    driver_semaphore_.reset();
+    return false;
+  }
+  REXAPU_WARN("APU: failed to create or initialize a media driver; continuing silently");
+
+  return true;
+}
+
+void AudioMediaPlayer::DeleteDriver() {
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (driver_) {
+    // Stop the driver before destroying the semaphore used by its callbacks.
+    driver_->Shutdown();
+    driver_.reset();
+  }
+  driver_semaphore_.reset();
+}
+
+}  // namespace rex::audio
