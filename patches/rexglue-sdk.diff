+// One receive into the guest's buffers (guest addresses), and the sender into `from_addr` /
+// `fromlen_addr` when given. Returns the bytes received, or -1 (the socket's error).
+int ReceiveInto(XSocket* socket, uint32_t buffers_addr, uint32_t buffer_count, uint32_t from_addr,
+                uint32_t fromlen_addr) {
+  auto* mem = REX_KERNEL_MEMORY();
+  auto* buffers = mem->TranslateVirtual<XWSABUF*>(buffers_addr);
+  uint32_t total = 0;
+  for (uint32_t i = 0; i < buffer_count; ++i) {
+    total += buffers[i].len;
+  }
+  std::vector<uint8_t> data(std::max<uint32_t>(total, 1));
+  N_XSOCKADDR_IN from = {};
+  uint32_t from_len = sizeof(sockaddr_in);
+  const int received = socket->RecvFrom(data.data(), total, 0, &from, &from_len);
+  if (received < 0) {
+    return received;
+  }
+  uint32_t offset = 0;
+  for (uint32_t i = 0; i < buffer_count && offset < uint32_t(received); ++i) {
+    const uint32_t n = std::min<uint32_t>(buffers[i].len, uint32_t(received) - offset);
+    std::memcpy(mem->TranslateVirtual(buffers[i].buf_ptr), data.data() + offset, n);
+    offset += n;
+  }
+  if (from_addr) {
+    auto* guest_from = mem->TranslateVirtual<XSOCKADDR_IN*>(from_addr);
+    guest_from->sin_family = from.sin_family;
+    guest_from->sin_port = from.sin_port;
+    guest_from->sin_addr = from.sin_addr;
+    std::memset(guest_from->x_sin_zero, 0, sizeof(guest_from->x_sin_zero));
+  }
+  if (fromlen_addr) {
+    memory::store_and_swap<uint32_t>(mem->TranslateVirtual(fromlen_addr),
+                                     uint32_t(sizeof(XSOCKADDR_IN)));
+  }
+  return received;
