+ */
+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <span>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/kernel/xam/apps/xmp_app.h>
+#include <rex/thread.h>
+
+struct AVCodecContext;
+struct AVFormatContext;
+struct AVFrame;
+
+namespace rex::system {
+class KernelState;
+}  // namespace rex::system
+
+namespace rex::audio {
+
+class AudioSystem;
+
+using XmpApp = kernel::xam::apps::XmpApp;
+
+// Plays XMP title playlists: decodes the WMA or MP3 files a title registers and
+// feeds the PCM to a host-format driver, outside the guest audio clients.
+class AudioMediaPlayer {
+ public:
+  AudioMediaPlayer(AudioSystem* audio_system, system::KernelState* kernel_state);
+  ~AudioMediaPlayer();
+
+  void Setup();
+  // Stops playback and joins the worker. The player stays usable as a state
+  // holder, but plays nothing more.
+  void Shutdown();
+
+  X_STATUS Play(uint32_t playlist_handle, uint32_t song_handle, bool force);
+  X_STATUS Next();
+  X_STATUS Previous();
+
+  void Stop(bool change_state = false, bool force = true);
+  void Pause();
+  void Continue();
+
+  XmpApp::State GetState() const { return state_.load(std::memory_order_acquire); }
+
+  bool IsIdle() const { return GetState() == XmpApp::State::kIdle; }
+  bool IsPlaying() const { return GetState() == XmpApp::State::kPlaying; }
+  bool IsPaused() const { return GetState() == XmpApp::State::kPaused; }
+  bool IsSongLoaded() const { return active_song_.load(std::memory_order_acquire) != nullptr; }
+
+  bool IsInRepeatMode() const { return repeat_mode_ == XmpApp::RepeatMode::kPlaylist; }
+
+  bool IsLastSongInPlaylist() const;
+
+  X_STATUS SetVolume(float volume);
+  const std::atomic<float>* GetVolume() const { return &volume_; }
+  // Local change (pgr4 project, 14/11/2026): the volume the title gives the music it captures
+  // (XMPCaptureOutput, left off here: the music goes straight out), as a console title sets it on the
+  // captured voice. Below 0: none, the controller's volume applies. Set, it is the player's output level
+  // whatever the controller: a change of playback controller put back another controller's volume over
+  // the title's (PGR4's music at 1.0 while the game asked for 0, quieter in a race than in its options).
+  void SetTitleVolume(float volume);
+  float GetTitleVolume() const { return title_volume_.load(std::memory_order_relaxed); }
+
+  void SetPlaybackMode(XmpApp::PlaybackMode playback_mode) { playback_mode_ = playback_mode; }
+  XmpApp::PlaybackMode GetPlaybackMode() const { return playback_mode_; }
+
+  void SetRepeatMode(XmpApp::RepeatMode repeat_mode) { repeat_mode_ = repeat_mode; }
+  XmpApp::RepeatMode GetRepeatMode() { return repeat_mode_; }
+
+  void SetPlaybackFlags(XmpApp::PlaybackFlags playback_flags) { playback_flags_ = playback_flags; }
+  XmpApp::PlaybackFlags GetPlaybackFlags() const { return playback_flags_; }
+
+  struct ControllerSettings {
+    XmpApp::PlaybackMode playback_mode = XmpApp::PlaybackMode::kInOrder;
+    XmpApp::RepeatMode repeat_mode = XmpApp::RepeatMode::kPlaylist;
+    XmpApp::PlaybackFlags playback_flags = XmpApp::PlaybackFlags::kDefault;
+    // Initial return before anything sets it.
+    // 20 x log10(0.251189) = -12 dB
+    float volume = 0.251189f;
+  };
+  ControllerSettings& GetControllerSettings(XMP_CLIENT xmp_client);
+
+  void SetXMPOverride(bool xmp_override) { xmp_override_ = xmp_override; }
+  bool IsXMPOverrideEnabled() const { return xmp_override_; }
+
+  uint32_t GetDashInitState() const { return dash_init_state; }
+
+  void SetXMPClient(XMP_CLIENT xmp_client) { xmp_client_ = xmp_client; }
+
+  void SetPlaybackController(PlaybackController playback_controller);
+
+  PlaybackController GetPlaybackController() const { return playback_controller_; }
+
+  XMP_CLIENT GetXMPClient() const { return xmp_client_; }
+
+  bool IsTitleInPlaybackControl() const {
+    if (IsXMPOverrideEnabled()) {
+      return false;
+    }
+
+    const bool game_control =
+        xmp_client_ == XMP_CLIENT::Game && playback_controller_ == PlaybackController::Game;
+
+    return game_control || xmp_override_ || is_title_rendering_enabled_;
+  }
+
+  void SetCaptureCallback(uint32_t callback, uint32_t context, bool title_render);
+  // Local change (pgr4 project, 14/11/2026): XMPCaptureOutput with title rendering. The decoded music
+  // goes to the title instead of the speakers: each call (the audio worker's, once per guest audio frame
+  // of client 0) adds a frame's time, and every 512 frames' worth hands the title a block of 512 stereo
+  // 16-bit 48 kHz frames (2048 bytes, big-endian) in guest memory: true with the title's callback, the
+  // block and its context to call it with (callback(block, context)), as the console's XMP does. The
+  // title plays it through its own mixer: its volume, fades and ducking.
+  bool TakeCaptureBlock(uint32_t* callback, uint32_t* block, uint32_t* context);
+  // The block just handed out back at the head of the queue: the title's voice was not ready for it
+  // (its callback drops such a block), so the worker stops for this frame and hands it again later.
+  // Called by the title's code (a hook) on the audio worker, during the callback.
+  void ReturnCaptureBlock();
+  bool TakeCaptureReturned() { return std::exchange(capture_returned_, false); }
+  bool CaptureActive() const;
+
+  void AddPlaylist(uint32_t handle, std::unique_ptr<XmpApp::Playlist> playlist);
+  void RemovePlaylist(uint32_t handle);
+
+  XmpApp::Song* GetCurrentSong() const { return active_song_.load(std::memory_order_acquire); }
+
+ private:
+  enum class PlayResult { kSuccessful, kForcedFinish, kFailure };
+
+  struct Request {
+    std::u16string file_path;
+    uint32_t song_handle = 0;
+    // stop_serial_ when the song was picked; a Stop since then bumps it.
+    uint32_t serial = 0;
+  };
+
+  void OnStateChanged();
+
+  void WorkerThreadMain();
+  void PlaySong(const Request& request);
+  PlayResult DecodeSong(const Request& request, AVFormatContext* format_context,
+                        AVCodecContext* codec_context, int stream_index);
+  // Appends the frame to pending_samples_ and submits every whole driver frame.
+  // False when the song was stopped while waiting for a free slot.
+  bool QueueFrame(const Request& request, const AVFrame* frame, int channel_count);
+  bool SubmitFrame(const Request& request, float* samples);
+  void DrainDriver(const Request& request);
+  void EndSong(const Request& request, PlayResult result);
+  std::span<uint8_t> LoadSongToMemory(const std::u16string& file_path);
+
+  bool IsCurrent(const Request& request) const {
+    return stop_serial_.load(std::memory_order_acquire) == request.serial;
+  }
+
+  // Requires mutex_. Returns whether a song was playing or paused.
+  bool StopLocked(std::unique_lock<std::mutex>& lock, bool force);
+  // Requires mutex_. Queues song for the worker.
+  void StartLocked(XmpApp::Song* song);
+  XmpApp::Playlist* FindPlaylistLocked(uint32_t handle) const;
+  bool IsLastSongInPlaylistLocked() const;
+  // Requires mutex_. The song after (or before) current_song_handle_ in the
+  // active playlist, wrapping around; null when there is none.
+  XmpApp::Song* AdjacentSongLocked(bool forward) const;
+  void WakeWorker();
+
+  std::atomic<XmpApp::State> state_ = XmpApp::State::kIdle;
+  bool xmp_override_ = false;
+  XmpApp::PlaybackMode playback_mode_ = XmpApp::PlaybackMode::kInOrder;
+  XmpApp::RepeatMode repeat_mode_ = XmpApp::RepeatMode::kPlaylist;
+  XmpApp::PlaybackFlags playback_flags_ = XmpApp::PlaybackFlags::kDefault;
+  PlaybackController playback_controller_ = PlaybackController::Game;
+  XMP_CLIENT xmp_client_ = XMP_CLIENT::Game;
+  ControllerSettings controller_settings_[4];
+  std::atomic<float> volume_ = 0.0f;
+  std::atomic<float> title_volume_ = -1.0f;  // SetTitleVolume
+  float OutputVolume() const;
+  uint32_t dash_init_state = 0;
+
+  std::unordered_map<uint32_t, std::unique_ptr<XmpApp::Playlist>> playlists_;
+  XmpApp::Playlist* active_playlist_ = nullptr;
+  std::atomic<XmpApp::Song*> active_song_ = nullptr;
+
+  uint32_t current_song_handle_ = 0;
+
+  uint32_t callback_ = 0;
+  uint32_t callback_context_ = 0;
+  bool is_title_rendering_enabled_ = false;
+
+  // XMPCaptureOutput (TakeCaptureBlock): the title's callback, its context and whether it renders the
+  // music itself; the music resampled to 48 kHz stereo 16-bit, waiting for the title; the guest blocks
+  // handed out in turn (a submitted block is read by the title's voice later).
+  std::atomic<uint32_t> capture_callback_ = 0, capture_context_ = 0;
+  std::atomic<bool> capture_title_render_ = false;
+  std::mutex capture_mutex_;
+  std::condition_variable capture_cv_;
+  std::deque<float> capture_fifo_;  // 48 kHz stereo, interleaved
+  uint32_t capture_rate_ = 48000, capture_channels_ = 2;
+  double capture_phase_ = 0.0;
+  float capture_previous_[2] = {};
+  uint32_t capture_credit_ = 0;
+  std::chrono::steady_clock::time_point capture_clock_{};
+  double capture_time_frames_ = 0.0;
+  uint64_t capture_handed_ = 0, capture_starved_ = 0;
+  uint32_t capture_blocks_ = 0, capture_next_ = 0;
+  bool CaptureFrame(const Request& request, const float* samples);
+  std::vector<float> capture_last_;  // the block last handed out, as queued
+  bool capture_returned_ = false;
+  uint32_t capture_last_frames_ = 0;
+
+  AudioSystem* audio_system_ = nullptr;
+  system::KernelState* kernel_state_ = nullptr;
+
+  // Guards the playlists, the active song and the worker handshake below.
+  mutable std::mutex mutex_;
+  std::condition_variable worker_cv_;
+  bool worker_running_ = false;
+  // A song was picked and the worker has not taken it yet.
+  bool start_requested_ = false;
+  // The worker is between taking a song and finishing with it.
+  bool in_play_ = false;
+  std::atomic<uint32_t> stop_serial_ = 0;
+  std::unique_ptr<rex::thread::Thread> worker_thread_;
+
+  // Interleaved decoder output not yet submitted. It only grows to the largest
+  // decoded frame, so steady decoding allocates nothing.
+  std::vector<float> pending_samples_;
+  size_t pending_count_ = 0;
+
+  // Driver part - This should be integrated into audio_system, but it isn't
+  // really compatible with it.
+  std::unique_ptr<AudioDriver> driver_ = nullptr;
+  std::unique_ptr<rex::thread::Semaphore> driver_semaphore_ = {};
+  std::mutex driver_mutex_ = {};
+
+  bool SetupDriver(uint32_t sample_rate, uint32_t channels);
+  void DeleteDriver();
+};
+
+}  // namespace rex::audio
