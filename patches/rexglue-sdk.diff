+// Local change (pgr4 project): the title's volume over the controller's (audio_media_player.h).
+float AudioMediaPlayer::OutputVolume() const {
+  const float title = title_volume_.load(std::memory_order_relaxed);
+  return title >= 0.0f ? std::min(title, 1.0f) : volume_.load(std::memory_order_relaxed);
+}
+
+void AudioMediaPlayer::SetTitleVolume(float volume) {
+  title_volume_.store(volume, std::memory_order_relaxed);
+  std::lock_guard<std::mutex> guard(driver_mutex_);
+  if (driver_) driver_->SetVolume(OutputVolume());
