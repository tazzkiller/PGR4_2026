+// getsockname / getpeername(s, name, namelen): the native socket's, IPv4.
+template <int (*Query)(SOCKET_HANDLE_T, sockaddr*, socklen_t*)>
+u32 SocketName(u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name, mapped_u32 namelen) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(kWsaENotSock);
+    return -1;
+  }
+  if (!name || !namelen || *namelen < sizeof(XSOCKADDR_IN)) {
+    XThread::SetLastError(0x271E);  // WSAEFAULT
+    return -1;
+  }
+  sockaddr_in native = {};
+  socklen_t native_len = sizeof(native);
+  if (Query(SOCKET_HANDLE_T(socket->native_handle()), reinterpret_cast<sockaddr*>(&native),
+            &native_len) != 0) {
+    SetSocketError();
+    return -1;
+  }
+  name->sin_family = native.sin_family;
+  name->sin_port = ntohs(native.sin_port);
+  name->sin_addr = ntohl(native.sin_addr.s_addr);
+  std::memset(name->x_sin_zero, 0, sizeof(name->x_sin_zero));
+  *namelen = sizeof(XSOCKADDR_IN);
+  return 0;
+}
+
+int NativeGetSockName(SOCKET_HANDLE_T s, sockaddr* name, socklen_t* len) {
+  return getsockname(s, name, len);
+}
+int NativeGetPeerName(SOCKET_HANDLE_T s, sockaddr* name, socklen_t* len) {
+  return getpeername(s, name, len);
+}
+
+u32 NetDll_getsockname_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name,
+                             mapped_u32 namelen) {
+  return SocketName<NativeGetSockName>(socket_handle, name, namelen);
+}
+
+u32 NetDll_getpeername_entry(u32 caller, u32 socket_handle, ppc_ptr_t<XSOCKADDR_IN> name,
+                             mapped_u32 namelen) {
+  return SocketName<NativeGetPeerName>(socket_handle, name, namelen);
+}
+
+// getsockopt(s, level, optname, optval, optlen): the native socket's, 4-byte values swapped.
+u32 NetDll_getsockopt_entry(u32 caller, u32 socket_handle, u32 level, u32 optname,
+                            mapped_void optval_ptr, mapped_u32 optlen_ptr) {
+  auto socket = REX_KERNEL_OBJECTS()->LookupObject<XSocket>(socket_handle);
+  if (!socket) {
+    XThread::SetLastError(kWsaENotSock);
+    return -1;
+  }
+  if (!optval_ptr || !optlen_ptr) {
+    XThread::SetLastError(0x271E);  // WSAEFAULT
+    return -1;
+  }
+  uint8_t value[16] = {};
+  socklen_t len = std::min<socklen_t>(socklen_t(*optlen_ptr), socklen_t(sizeof(value)));
+  if (getsockopt(SOCKET_HANDLE_T(socket->native_handle()), int(level), int(optname),
+                 reinterpret_cast<char*>(value), &len) != 0) {
+    SetSocketError();
+    return -1;
+  }
+  if (len == 4) {
+    uint32_t v;
+    std::memcpy(&v, value, 4);
+    memory::store_and_swap<uint32_t>(static_cast<uint8_t*>(optval_ptr), v);
+  } else {
+    std::memcpy(optval_ptr, value, len);
+  }
+  *optlen_ptr = uint32_t(len);
+  return 0;
+}
