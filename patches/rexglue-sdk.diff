+// Installs the packages of DLC and title updates found in content_root that are not installed
+// yet, each for the title its header names. It runs before the executable loads, which applies an
+// installed title update. A package counts as installed once its .header is written, the last
+// step of InstallContent, so an interrupted install is redone.
+void InstallContentPackagesIn(system::KernelState& kernel_state,
+                              const std::filesystem::path& root) {
+  std::error_code ec;
+  if (!std::filesystem::is_directory(root, ec)) {
+    return;
+  }
+  auto* content = kernel_state.content_manager();
+  for (const auto& entry : std::filesystem::directory_iterator(root, ec)) {
+    if (!entry.is_regular_file(ec)) {
+      continue;
+    }
+    filesystem::StfsContainerDevice package("", entry.path());
+    if (!package.Initialize()) {
+      continue;
+    }
+    const auto& metadata = package.header().metadata;
+    const system::XContentType content_type = metadata.content_type;
+    if (content_type != system::XContentType::kMarketplaceContent &&
+        content_type != system::XContentType::kInstaller) {
+      continue;
+    }
+    const auto file_name = path_to_utf8(entry.path().filename());
+    system::xam::XCONTENT_AGGREGATE_DATA installed;
+    if (content->ReadContentHeaderFile(file_name, 0, metadata.execution_info.title_id, content_type,
+                                       installed) == X_ERROR_SUCCESS) {
+      continue;
+    }
+    const auto result = content->InstallContent(entry.path());
+    if (result == X_ERROR_SUCCESS) {
+      REXLOG_INFO("Installed content package {} ({})", file_name,
+                  string::to_utf8(metadata.display_name(system::XLanguage::kEnglish)));
+    } else {
+      REXLOG_ERROR("Installing content package {} failed: {:08X}", entry.path().string(), result);
+    }
+  }
+}
+
+// content_root's packages (default <game_data_root>/Content), then dlc_root's (local change).
+void InstallContentPackages(system::KernelState& kernel_state,
+                            const std::filesystem::path& game_data_root) {
+  const std::string root_cvar = REXCVAR_GET(content_root);
+  InstallContentPackagesIn(kernel_state, root_cvar.empty() ? game_data_root / "Content"
+                                                           : std::filesystem::path(root_cvar));
+  if (const std::string dlc = REXCVAR_GET(dlc_root); !dlc.empty())
+    InstallContentPackagesIn(kernel_state, std::filesystem::path(dlc));
+}
