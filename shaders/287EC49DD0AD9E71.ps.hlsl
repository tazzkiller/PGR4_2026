  XE_STACKED_TF0.GetDimensions(width, height, layers);
  float l = clamp(uvw.z * layers - 0.5, 0.0, layers - 1.0);
  float l0 = floor(l);
  float4 a = XE_STACKED_TF0.Sample(XE_SAMPLER_TF0, float3(uvw.xy, l0));
  float4 b = XE_STACKED_TF0.Sample(XE_SAMPLER_TF0, float3(uvw.xy, min(l0 + 1.0, layers - 1.0)));
